# =====================================================================
# SMRITI SHUDDHI CONFIGURATION
# =====================================================================

# TIER 1: SUPABASE POSTGRESQL + PGVECTOR (RECOMMENDED PRODUCTION ARCHITECTURE)
# Paste your Supabase URI from: Project Settings -> Database -> Connection string (URI)
# e.g. Transaction Pooler URI: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase Storage & API Keys (Optional - For Citizen Uploads & Dossier Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=smriti-shuddhi-storage

# LEGACY / LOCAL FALLBACK DATABASES (Used automatically if DATABASE_URL is empty)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fake_news_unlearning
SECRET_KEY=change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
HOST=0.0.0.0
PORT=8080
ALLOWED_ORIGINS=*
MODEL_BACKEND=hybrid_lora
FAKE_THRESHOLD_HIGH=0.70
FAKE_THRESHOLD_LOW=0.30
SISA_SHARDS=5
SISA_SLICES=5
RANDOM_STATE=42

# Optional News & Verification API Keys
# Smriti Shuddhi uses free public Google News/The Hindu/TOI/BBC RSS + Open-Meteo + Wikidata if keys are empty.
GUARDIAN_API_KEY=
THE_NEWS_API_TOKEN=
GOOGLE_FACTCHECK_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
NEWS_API_KEY=
GNEWS_API_KEY=
NEWS_AUTO_SYNC_MINUTES=5
