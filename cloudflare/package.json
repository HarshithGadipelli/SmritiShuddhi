{
  "name": "smritishuddhi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "node scripts/build-pages.mjs && wrangler pages deploy dist-pages --project-name=smritishuddhi --branch=main --commit-dirty=true",
    "deploy": "wrangler deploy && npm run deploy:pages",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "cf": "^0.15.0",
    "typescript": "^6.0.2",
    "wrangler": "4.168.0"
  }
}