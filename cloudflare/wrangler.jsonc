{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smritishuddhi",
  "account_id": "0e9d9e3453b93f963b60116f28e8368a",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/sync-assets.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/ws",
      "/favicon.ico",
      "/static/uploads/*"
    ]
  },
  "vars": {
    "BACKEND_URL": "https://smritishuddhi-889339834867.asia-south1.run.app"
  }
}
